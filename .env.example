# Leave Supabase blank to run the self-contained local demo (no backend needed).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Must match Authentication → Providers → Email → Email OTP length on the project
# (the `dolemon` project uses 8; new Supabase projects default to 8). A mismatch
# leaves the verify screen with the wrong number of boxes.
NEXT_PUBLIC_OTP_LENGTH=8

# "demo" | "supabase" | leave empty for auto:
# auto = Supabase when configured, local otherwise
NEXT_PUBLIC_AUTH_MODE=

# --- Web Push (optional) ---------------------------------------------------
# One keypair per deployment; rotating it invalidates existing subscriptions.
# `npx web-push generate-vapid-keys` prints the pair. Push stays "not
# configured" until all three are set. The database webhook needs no secret
# here — it lives in public.push_webhook_config (migration 019).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: when set, the daily cleanup routes require `Authorization: Bearer <CRON_SECRET>`.
# They only delete already-expired or orphaned files, so this is defence in depth.
CRON_SECRET=

# --- Doremon (the resident AI) --------------------------------------------
# Server-side only — never prefix with NEXT_PUBLIC. Get a key at
# https://aistudio.google.com/apikey . Without a key Doremon still works in
# the demo; live mode needs a working key and available quota.
GEMINI_API_KEY=
# Model is hardcoded to gemini-3.1-flash-lite; check quota in AI Studio.
