# Leave Supabase blank to run the self-contained local demo (no backend needed).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase email OTP length (new projects default to 8)
NEXT_PUBLIC_OTP_LENGTH=6

# "demo" | "supabase" | leave empty for auto:
# auto = Supabase when configured, local otherwise
NEXT_PUBLIC_AUTH_MODE=

# --- Doremon (the resident AI) --------------------------------------------
# Server-side only — never prefix with NEXT_PUBLIC. Get a key at
# https://aistudio.google.com/apikey . Without a key Doremon still works in
# the demo and falls back to his local (lighter) brain in live mode.
GEMINI_API_KEY=
# Latest Flash by default — bump to the newest flash release whenever you like.
GEMINI_MODEL=gemini-2.5-flash
